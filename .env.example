PORT=3000
# Dentro de docker compose el host de Mongo es el servicio "mongo"
MONGO_URI=mongodb://mongo:27017/minho_gloss
CORS_ORIGIN=http://localhost:5173
# URL del frontend, para armar el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Sesión (JWT). En producción JWT_SECRET es obligatorio y de al menos 32 caracteres:
# genera uno con `openssl rand -hex 32`.
JWT_SECRET=dev-secret-solo-para-desarrollo-no-usar-en-produccion
JWT_EXPIRES_IN=12h

# Administrador inicial: se crea al arrancar solo si la base no tiene usuarios.
ADMIN_EMAIL=admin@minhogloss.local
ADMIN_PASSWORD=MinhoGloss2026
ADMIN_NOMBRE=Administrador

# Recuperación de contraseña: minutos que dura el enlace enviado por correo
RESET_PASSWORD_EXPIRES_MINUTES=60

# Correo por SMTP. En desarrollo apunta a Mailpit (bandeja en http://localhost:8025).
# En producción usa un proveedor gratuito, por ejemplo Resend:
#   SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASS=<api key>
# Sin SMTP_HOST no se envían correos (solo se registra una advertencia).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Minho Gloss <no-responder@minhogloss.local>

# Código de país que se agrega a los teléfonos escritos sin él (Portugal)
DEFAULT_COUNTRY_CODE=351
